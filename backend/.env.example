# ---- 应用 ----
APP_ENV=dev
APP_ADDR=:8080

# ---- 数据库 ----
# 可选 sqlite | postgres
DB_DRIVER=sqlite
# sqlite: 文件路径；postgres: 连接串
DB_DSN=./data/lens.db
# DB_DRIVER=postgres
# DB_DSN=postgres://lens:lens@localhost:5432/lensqs?sslmode=disable
DB_MAX_OPEN=10
DB_MAX_IDLE=5
AUTO_MIGRATE=true

# ---- 认证 ----
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
MAX_LOGIN_FAIL=5
LOCK_DURATION=10m
COOKIE_NAME=sid
COOKIE_SECURE=false
# 允许跨域的来源，多个用逗号分隔；留空表示不下发 CORS 头
CORS_ORIGINS=

# ---- 首次启动自动创建管理员（数据库为空时生效）----
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=
