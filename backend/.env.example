# ---- 应用 ----
APP_ENV=dev
APP_ADDR=:8080

# ---- 数据库 ----
# 可选 sqlite | postgres
DB_DRIVER=sqlite
# sqlite: 文件路径；postgres: 连接串
DB_DSN=./data/lens.db
# DB_DRIVER=postgres
# DB_DSN=postgres://<user>:<password>@localhost:5432/lensqs?sslmode=disable
DB_MAX_OPEN=10
DB_MAX_IDLE=5

# ---- 认证 ----
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
MAX_LOGIN_FAIL=5
LOCK_DURATION=10m
COOKIE_NAME=sid
COOKIE_SECURE=false
# Cookie 写请求只允许下列明确来源；多个用逗号分隔，不支持通配符。
# 例如 http://localhost:5173；留空时请使用 Bearer 调用。
CORS_ORIGINS=

# 初始账号使用 cmd/createuser 显式创建；启动不初始化账号或数据。
