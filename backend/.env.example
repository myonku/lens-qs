# ---- 应用 ----
APP_ENV=dev
APP_ADDR=:8080

# ---- 工序映射 ----
# 相对路径以启动工作目录为准；缺失或格式错误时拒绝启动。
OPERATION_CATALOG_FILE=./data/inspection_operations.csv

# ---- 数据库 ----
# 可选 sqlite | postgres
DB_DRIVER=sqlite
# sqlite: 文件路径；postgres: 连接串
DB_DSN=./data/lens.db
# DB_DRIVER=postgres
# DB_DSN=postgres://<user>:<password>@localhost:5432/lensqs?sslmode=disable
DB_MAX_OPEN=10
DB_MAX_IDLE=5

# ---- 认证 ----
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
MAX_LOGIN_FAIL=5
LOCK_DURATION=10m
COOKIE_NAME=sid
COOKIE_SECURE=false
# Cookie 写请求只允许下列明确来源；多个用逗号分隔，不支持通配符。
# 本机默认 8080；前端使用其他域名/端口时显式追加准确 Origin。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ---- 初始管理员（可选，没有默认账号或密码） ----
# 仅空用户库启动时创建；用户库非空时启动忽略全部引导项。
# 显式同步资料：go run ./cmd/createuser -from-env
# 已有登录名/密码不覆盖；仅非空的身份、显示名、工号、部门可更新。
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASS=
# 创建时默认 NORMAL；已有账号同步时留空表示不修改。
BOOTSTRAP_ADMIN_ACCOUNT_TYPE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMP=
BOOTSTRAP_ADMIN_DEPARTMENT=
