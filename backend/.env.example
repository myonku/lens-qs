# ---- 应用 ----
APP_ENV=dev
APP_ADDR=:8080

# ---- 数据库 ----
# 可选 sqlite | postgres
DB_DRIVER=sqlite
# sqlite: 文件路径；postgres: 连接串
DB_DSN=./data/lens.db
# DB_DRIVER=postgres
# DB_DSN=postgres://lens:lens@localhost:5432/lensqs?sslmode=disable
DB_MAX_OPEN=10
DB_MAX_IDLE=5
AUTO_MIGRATE=true

# ---- 认证 ----
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
MAX_LOGIN_FAIL=5
LOCK_DURATION=10m
COOKIE_NAME=sid
COOKIE_SECURE=false
# 允许跨域的来源，多个用逗号分隔；`*` 表示放行任意来源。
# 【前端联调必看】留空 = **不下发任何 CORS 头**，浏览器带 Cookie 的请求会被同源策略拦掉
# （curl 正常但前端报跨域）。本地开发建议 `*`，生产改成具体来源。
CORS_ORIGINS=

# ---- 首次启动自动创建管理员 ----
# 系统**没有内置默认账号**。这两个值只在"数据库里一个用户都没有"时生效：
# 库为空则自动创建该管理员；库中已有用户则忽略（不会改密码）。
# 想重置管理员密码：bin/lens-qs-createuser -username admin -password 新密码 -update
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASS=Admin@12345

# 唯一业务写入口：v2（默认）或 legacy（迁移准备期间）；另一域只读
BUSINESS_WRITE_DOMAIN=v2
