# 统一换行符为 LF（仓库内），检出时由各平台自行转换
* text=auto eol=lf

*.md   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.docx binary
