# ════════════════ 通用（根目录） ════════════════

# ── 依赖与构建产物 ──
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# ── 环境变量与密钥 ──
.env
.env.*
!.env.example

# ── 日志与临时文件 ──
*.log
npm-debug.log*
pnpm-debug.log*
tmp/
temp/

# ── 上传/导出产物 ──
uploads/
exports/
*.xlsx
*.pdf
!docs/**/*.pdf

# ── 备份 ──
backups/
*.dump
*.sql.gz

# ── 编辑器与系统 ──
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# ════════════════ 后端（backend/，Go） ════════════════

# 编译产物
backend/bin/
*.exe
*.test
*.out
coverage.txt

# 本地数据库（开发期 SQLite）
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
